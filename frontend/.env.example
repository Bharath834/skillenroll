# ---------------------------------------------------------------------------
# SkillEnroll frontend environment variables
# Copy this file to `.env` and adjust as needed. Vite exposes only variables
# prefixed with VITE_ to the browser.
#
# Local backend (recommended for development): serves every /api/* endpoint
# (auth, users, courses, enrollments, lessons, progress) directly on :8080.
#   VITE_API_BASE_URL=http://localhost:8080/api
#
# Alternative — via the API gateway (:8081). Note the gateway currently routes
# only /api/auth/**, /api/users/** and /api/courses/**; enrollment, lesson and
# progress endpoints are not proxied yet, so prefer the backend URL for full
# functionality during development.
#   VITE_API_BASE_URL=http://localhost:8081/api
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

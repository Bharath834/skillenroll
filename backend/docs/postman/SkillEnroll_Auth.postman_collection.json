{
  "info": {
    "_postman_id": "6f3a1c8e-2d4b-4a9f-b7e2-0a1b2c3d4e5f",
    "name": "SkillEnroll - Auth + User Profile (Day 3 Complete)",
    "description": "Complete verification suite for the SkillEnroll authentication module (Day 3: JWT claims, /api/users/me, refresh tokens, logout + JWT blacklist, Swagger UI).\n\nBase URL: {{baseUrl}} (default http://localhost:8080).\n\nAfter a successful Register or Login, the returned JWT and refresh token are stored in the collection variables {{token}} and {{refreshToken}} (set via the Test scripts), so the protected, refresh and logout requests can be executed directly.\n\nThe Test scripts also decode the JWT payload and verify the Day 3 claims: sub (email), userId, firstName, lastName and role.\n\nRun order: 1 → 2 → 3 … → 12 → 13 (old access token rejected after logout) → 14 (reuse of the logged-out refresh token).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Register User (expect 201 + JWT claims)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Body has success=true and a JWT token', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.token).to.be.a('string');",
              "    pm.expect(body.data.user.role).to.eql('STUDENT');",
              "    pm.collectionVariables.set('token', body.data.token);",
              "    pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
              "});",
              "pm.test('JWT payload carries Day 3 claims with email as subject', function () {",
              "    const token = pm.collectionVariables.get('token');",
              "    const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
              "    pm.expect(payload.sub).to.eql('alice.wonder@example.com');",
              "    pm.expect(payload.userId).to.be.a('number');",
              "    pm.expect(payload.firstName).to.eql('Alice');",
              "    pm.expect(payload.lastName).to.eql('Wonder');",
              "    pm.expect(payload.role).to.eql('STUDENT');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Wonder\",\n  \"email\": \"alice.wonder@example.com\",\n  \"phoneNumber\": \"9876543210\",\n  \"password\": \"Passw0rd!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "2. Login (expect 200 + JWT claims)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Body contains JWT token', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.token).to.be.a('string');",
              "    pm.collectionVariables.set('token', body.data.token);",
              "    pm.collectionVariables.set('refreshToken', body.data.refreshToken);",
              "});",
              "pm.test('JWT payload carries Day 3 claims with email as subject', function () {",
              "    const token = pm.collectionVariables.get('token');",
              "    const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
              "    pm.expect(payload.sub).to.eql('alice.wonder@example.com');",
              "    pm.expect(payload.userId).to.be.a('number');",
              "    pm.expect(payload.firstName).to.eql('Alice');",
              "    pm.expect(payload.lastName).to.eql('Wonder');",
              "    pm.expect(payload.role).to.eql('STUDENT');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice.wonder@example.com\",\n  \"password\": \"Passw0rd!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {

    {
      "name": "13. Old Access Token after Logout (expect 401 - blacklisted)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 401 Unauthorized', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test('Token was rejected as revoked', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.message).to.include('revoked');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        }
      }
    },
    {
      "name": "14. Refresh with Revoked Token after Logout (expect 409 reuse)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 409 Conflict', function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test('Reuse detection message returned', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(false);",
              "    pm.expect(body.message).to.include('reuse detected');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }

          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "9. Get Current User /api/users/me (expect 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Profile matches the authenticated user', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.success).to.eql(true);",
              "    pm.expect(body.data.id).to.be.a('number');",
              "    pm.expect(body.data.email).to.eql('alice.wonder@example.com');",
              "    pm.expect(body.data.firstName).to.eql('Alice');",
              "    pm.expect(body.data.lastName).to.eql('Wonder');",
              "    pm.expect(body.data.role).to.eql('STUDENT');",
              "    pm.expect(body.data.password).to.not.exist;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "me"]
        }
      }
    },
